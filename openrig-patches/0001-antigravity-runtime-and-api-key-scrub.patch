diff --git a/packages/daemon/test/topdrive-tmux-scrub.test.ts b/packages/daemon/test/topdrive-tmux-scrub.test.ts
new file mode 100644
index 0000000..55d0a0f
--- /dev/null
+++ b/packages/daemon/test/topdrive-tmux-scrub.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it, vi } from "vitest";
+import { TmuxAdapter } from "../src/adapters/tmux.js";
+
+function adapter(shell = "zsh") {
+  const calls: string[][] = [];
+  const argvExec = vi.fn(async (argv: string[]) => { calls.push(argv); return argv[1] === "display-message" ? `${shell}\n` : ""; });
+  const t = new TmuxAdapter(vi.fn(async () => ""), undefined, argvExec as never);
+  return { t, calls };
+}
+
+describe("TmuxAdapter billing scrub (subscription_only)", () => {
+  it("unsets API-credential env in every freshly created pane shell, after new-session", async () => {
+    const { t, calls } = adapter();
+    t.setEnvScrub(["ANTHROPIC_API_KEY", "OPENAI_API_KEY"]);
+    expect((await t.createSession("s@rig", "/w", { OPENRIG_NODE_ID: "n" })).ok).toBe(true);
+    expect(calls[0]!.slice(0, 3)).toEqual(["tmux", "new-session", "-d"]);
+    const send = calls.find((c) => c[1] === "send-keys")!;
+    expect(send).toEqual(["tmux", "send-keys", "-t", "s@rig", "unset ANTHROPIC_API_KEY OPENAI_API_KEY", "C-m"]);
+  });
+  it("is off by default (existing behavior unchanged)", async () => {
+    const { t, calls } = adapter();
+    await t.createSession("s@rig", "/w");
+    expect(calls.some((c) => c[1] === "send-keys")).toBe(false);
+  });
+  it("only accepts env-var-shaped names (no shell injection through config)", () => {
+    const { t } = adapter();
+    expect(() => t.setEnvScrub(["OK_NAME", "BAD; rm -rf /"])).toThrow(/invalid env name/);
+  });
+  it("a failed scrub fails the launch closed and removes the just-created session (§54)", async () => {
+    const calls: string[][] = [];
+    const argvExec = vi.fn(async (argv: string[]) => { calls.push(argv); if (argv[1] === "send-keys") throw new Error("pane gone"); return argv[1] === "display-message" ? "bash" : ""; });
+    const t = new TmuxAdapter(vi.fn(async () => ""), undefined, argvExec as never);
+    t.setEnvScrub(["OPENAI_API_KEY"]);
+    const r = await t.createSession("s@rig", "/w");
+    expect(r).toMatchObject({ ok: false });
+    expect(calls.some((c) => c[1] === "kill-session" && c.includes("s@rig"))).toBe(true);
+  });
+
+  const sendOf = (calls: string[][]) => calls.find((c) => c[1] === "send-keys")![4];
+  it.each([["bash", "unset A B"], ["-zsh", "unset A B"], ["sh", "unset A B"], ["dash", "unset A B"], ["fish", "set -e A B"], ["nu", "hide-env --ignore-errors A B"]])(
+    "uses the %s dialect to remove variables from the pane shell", async (shell, expected) => {
+      const { t, calls } = adapter(shell);
+      t.setEnvScrub(["A", "B"]);
+      expect((await t.createSession("s@rig", "/w")).ok).toBe(true);
+      expect(sendOf(calls)).toBe(expected);
+    });
+  it("an unknown pane shell fails closed: session removed, launch refused (a scrub that cannot be delivered must not be assumed)", async () => {
+    const { t, calls } = adapter("xonsh");
+    t.setEnvScrub(["A"]);
+    const r = await t.createSession("s@rig", "/w");
+    expect(r.ok).toBe(false);
+    expect(calls.some((c) => c[1] === "kill-session")).toBe(true);
+    expect(calls.some((c) => c[1] === "send-keys")).toBe(false);
+  });
+});
