@@ -0,0 +1,140 @@
+import { describe, expect, it, vi } from "vitest";
+import { AntigravityRuntimeAdapter, AGY_CONVERSATIONS_DIR_DEFAULT } from "../src/adapters/antigravity-runtime-adapter.js";
+import type { TmuxAdapter } from "../src/adapters/tmux.js";
+
+const seat = "impl-worker@rig";
+const READY = "Antigravity CLI 1.2.14\n> \n? for shortcuts   Gemini 3.8 Flash · high";
+const TRUST = "Do you trust the contents of this project?\n> Yes, I trust this folder";
+
+function make(opts: { pane?: string; paneCmd?: string; alive?: boolean; files?: string[]; g1?: boolean | "unknown" | Error } = {}) {
+  const files = opts.files ?? [];
+  const writes: Record<string, string> = {};
+  const tmux = {
+    hasSession: vi.fn(async () => opts.alive ?? true),
+    getPaneCommand: vi.fn(async () => opts.paneCmd ?? "agy"),
+    capturePaneContent: vi.fn(async () => opts.pane ?? READY),
+    sendShellCommand: vi.fn(async () => ({ ok: true })),
+    sendText: vi.fn(async () => ({ ok: true })),
+    sendKeys: vi.fn(async () => ({ ok: true })),
+  } as unknown as TmuxAdapter;
+  const fsOps = {
+    readFile: (p: string) => writes[p] ?? "",
+    writeFile: (p: string, c: string) => { writes[p] = c; },
+    exists: () => true,
+    mkdirp: () => {},
+    listFiles: () => files,
+  };
+  const adapter = new AntigravityRuntimeAdapter({ tmux, fsOps, conversationsDir: AGY_CONVERSATIONS_DIR_DEFAULT, sleep: async () => {},
+    ...(opts.g1 !== undefined ? { readUseG1Credits: async () => { if (opts.g1 instanceof Error) throw opts.g1; return opts.g1 as boolean | "unknown"; } } : {}) });
+  return { adapter, tmux, writes };
+}
+const binding = (extra: object = {}) => ({ tmuxSession: seat, cwd: "/work", ...extra }) as never;
+const cmdOf = (tmux: TmuxAdapter) => vi.mocked(tmux.sendShellCommand).mock.calls[0]![1] as string;
+
+describe("AntigravityRuntimeAdapter.launchHarness", () => {
+  it("launches agy fresh, strips API-credential env (billing guard), no bypass flag by default", async () => {
+    const { adapter, tmux } = make();
+    const r = await adapter.launchHarness(binding({ launchPosture: "floor" }), { name: seat });
+    expect(r.ok).toBe(true);
+    const cmd = cmdOf(tmux);
+    expect(cmd).toContain("env -u GEMINI_API_KEY -u GOOGLE_API_KEY");
+    expect(cmd).toMatch(/\bagy\b/);
+    expect(cmd).not.toContain("--dangerously-skip-permissions");
+    expect(cmd).not.toContain("--conversation");
+  });
+  it("adds the bypass flag only for an explicit full_bypass posture", async () => {
+    const { adapter, tmux } = make();
+    await adapter.launchHarness(binding({ launchPosture: "full_bypass" }), { name: seat });
+    expect(cmdOf(tmux)).toContain("--dangerously-skip-permissions");
+  });
+  it("resumes via --conversation <uuid> and returns the same token", async () => {
+    const { adapter, tmux } = make();
+    const id = "07698086-b5ae-4e6d-af8c-ea8089009391";
+    const r = await adapter.launchHarness(binding(), { name: seat, resumeToken: id });
+    expect(r).toMatchObject({ ok: true, resumeToken: id, resumeType: "antigravity_id" });
+    expect(cmdOf(tmux)).toContain(`--conversation '${id}'`);
+  });
+  it("rejects a shell-unsafe resume token before typing anything", async () => {
+    const { adapter, tmux } = make();
+    const r = await adapter.launchHarness(binding(), { name: seat, resumeToken: "x; rm -rf /" });
+    expect(r.ok).toBe(false);
+    expect(tmux.sendShellCommand).not.toHaveBeenCalled();
+  });
+  it("refuses fork and resume+fork", async () => {
+    const { adapter } = make();
+    expect((await adapter.launchHarness(binding(), { name: seat, forkSource: { kind: "native_id", value: "a" } })).ok).toBe(false);
+    expect((await adapter.launchHarness(binding(), { name: seat, resumeToken: "a", forkSource: { kind: "native_id", value: "a" } })).ok).toBe(false);
+  });
+  it("passes model and effort", async () => {
+    const { adapter, tmux } = make();
+    await adapter.launchHarness(binding({ model: "gemini-3.1-pro-high", effort: "high" }), { name: seat });
+    expect(cmdOf(tmux)).toContain("--model 'gemini-3.1-pro-high'");
+    expect(cmdOf(tmux)).toContain("--effort 'high'");
+  });
+});
+
+describe("AntigravityRuntimeAdapter.checkReady", () => {
+  it("ready on the shortcuts footer", async () => {
+    expect(await make().adapter.checkReady(binding())).toEqual({ ready: true });
+  });
+  it("trust gate is an attention-required code", async () => {
+    const r = await make({ pane: TRUST, paneCmd: "bash" }).adapter.checkReady(binding());
+    expect(r).toMatchObject({ ready: false, code: "trust_gate" });
+    expect(r.reason).toContain("trust");
+  });
+  it("a visible ready footer wins even when pane_current_command is a shell (agy runs on the alternate screen; probed: cmd=bash while agy is up)", async () => {
+    expect(await make({ paneCmd: "bash" }).adapter.checkReady(binding())).toEqual({ ready: true });
+  });
+  it("no TUI marker and the pane at a shell => agy exited", async () => {
+    expect(await make({ paneCmd: "zsh", pane: "brandon@host % " }).adapter.checkReady(binding())).toMatchObject({ ready: false, code: "runner_exited" });
+  });
+  it("dead tmux session is not ready", async () => {
+    expect((await make({ alive: false }).adapter.checkReady(binding())).ready).toBe(false);
+  });
+  it("blank pane is awaiting_runtime", async () => {
+    expect(await make({ pane: "" }).adapter.checkReady(binding())).toMatchObject({ ready: false, code: "awaiting_runtime" });
+  });
+});
+
+describe("AntigravityRuntimeAdapter.captureConversationId", () => {
+  it("returns the one new conversation uuid and ignores -shm/-wal", () => {
+    const { adapter } = make({ files: ["old.db", "fe89c4c3-0a5e-49a9-b181-a83b5feff825.db", "fe89c4c3-0a5e-49a9-b181-a83b5feff825.db-wal"] });
+    expect(adapter.captureConversationId(new Set(["old.db"]))).toBe("fe89c4c3-0a5e-49a9-b181-a83b5feff825");
+  });
+  it("returns null when ambiguous or absent (never guesses)", () => {
+    const a = "fe89c4c3-0a5e-49a9-b181-a83b5feff825.db", b = "aaaaaaaa-0a5e-49a9-b181-a83b5feff825.db";
+    expect(make({ files: [a, b] }).adapter.captureConversationId(new Set())).toBeNull();
+    expect(make({ files: [] }).adapter.captureConversationId(new Set())).toBeNull();
+  });
+});
+
+describe("AntigravityRuntimeAdapter.deliverStartup", () => {
+  it("send_text types into the pane and submits", async () => {
+    const { adapter, tmux } = make();
+    const r = await adapter.deliverStartup([{ path: "a.txt", absolutePath: "/a.txt", ownerRoot: "/", deliveryHint: "send_text", required: true, appliesOn: ["fresh_start"] }], binding());
+    expect(r.delivered).toBe(1);
+    expect(tmux.sendText).toHaveBeenCalled();
+    expect(tmux.sendKeys).toHaveBeenCalledWith(seat, ["C-m"]);
+  });
+});
+
+describe("AntigravityRuntimeAdapter paid-credit guard (spec §9, §79)", () => {
+  it("useG1Credits=true blocks the launch (fail closed) with a concrete reason, and types nothing", async () => {
+    const { adapter, tmux } = make({ g1: true });
+    const r = await adapter.launchHarness(binding(), { name: seat });
+    expect(r).toMatchObject({ ok: false, error: expect.stringContaining("useG1Credits") });
+    expect(tmux.sendShellCommand).not.toHaveBeenCalled();
+  });
+  it("blocks resume-by-launch too (same entry point)", async () => {
+    const { adapter, tmux } = make({ g1: true });
+    expect((await adapter.launchHarness(binding(), { name: seat, resumeToken: "07698086-b5ae-4e6d-af8c-ea8089009391" })).ok).toBe(false);
+    expect(tmux.sendShellCommand).not.toHaveBeenCalled();
+  });
+  it("false launches; unknown/unreadable launches (warned elsewhere: doctor), never blocks on a probe failure", async () => {
+    for (const g1 of [false, "unknown", new Error("agy busy")] as const) {
+      const { adapter, tmux } = make({ g1 });
+      expect((await adapter.launchHarness(binding(), { name: seat })).ok).toBe(true);
+      expect(tmux.sendShellCommand).toHaveBeenCalled();
+    }
+  });
+});
