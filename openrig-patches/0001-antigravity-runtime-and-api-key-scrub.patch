+import { describe, expect, it, vi } from "vitest";
+import { AntigravityResumeAdapter } from "../src/adapters/antigravity-resume.js";
+import type { TmuxAdapter } from "../src/adapters/tmux.js";
+
+const ID = "07698086-b5ae-4e6d-af8c-ea8089009391";
+const READY = "Antigravity CLI\n> \n? for shortcuts";
+
+function mk(panes: string[], g1?: boolean | "unknown") {
+  let i = 0;
+  const tmux = {
+    sendShellCommand: vi.fn(async () => ({ ok: true })),
+    capturePaneContent: vi.fn(async () => panes[Math.min(i++, panes.length - 1)] ?? ""),
+    getPaneCommand: vi.fn(async () => "bash"),
+  } as unknown as TmuxAdapter;
+  return { a: new AntigravityResumeAdapter(tmux, { pollMs: 1, maxWaitMs: 50, sleep: async () => {}, ...(g1 !== undefined ? { readUseG1Credits: async () => g1 } : {}) }), tmux };
+}
+
+describe("AntigravityResumeAdapter", () => {
+  it("canResume only for antigravity_id with a token", () => {
+    const { a } = mk([]);
+    expect(a.canResume("antigravity_id", ID)).toBe(true);
+    expect(a.canResume("antigravity_id", null)).toBe(false);
+    expect(a.canResume("codex_id", ID)).toBe(false);
+  });
+  it("relaunches with --conversation <id> (billing scrub kept, no bypass flag by default) and succeeds once the TUI is ready", async () => {
+    const { a, tmux } = mk(["", READY]);
+    expect(await a.resume("dev-gem@rig", "antigravity_id", ID, "/w", "gemini-3.1-pro-high", "floor")).toMatchObject({ ok: true });
+    const cmd = vi.mocked(tmux.sendShellCommand).mock.calls[0]![1] as string;
+    expect(cmd).toContain(`--conversation '${ID}'`);
+    expect(cmd).toContain("env -u GEMINI_API_KEY");
+    expect(cmd).toContain("--model 'gemini-3.1-pro-high'");
+    expect(cmd).not.toContain("--dangerously-skip-permissions");
+  });
+  it("full_bypass posture adds the bypass flag", async () => {
+    const { a, tmux } = mk([READY]);
+    await a.resume("s", "antigravity_id", ID, "/w", null, "full_bypass");
+    expect(vi.mocked(tmux.sendShellCommand).mock.calls[0]![1]).toContain("--dangerously-skip-permissions");
+  });
+  it("trust prompt => attention_required, not failure (operator trusts the folder once)", async () => {
+    const { a } = mk(["Do you trust the contents of this project?"]);
+    expect(await a.resume("s", "antigravity_id", ID, "/w", null)).toMatchObject({ ok: false, code: "attention_required" });
+  });
+  it("never becomes ready => failed with the tail evidence", async () => {
+    const { a } = mk(["booting..."]);
+    expect(await a.resume("s", "antigravity_id", ID, "/w", null)).toMatchObject({ ok: false, code: "resume_not_ready" });
+  });
+  it("a shell-unsafe token is refused before anything is typed", async () => {
+    const { a, tmux } = mk([READY]);
+    expect(await a.resume("s", "antigravity_id", "x; rm -rf /", "/w", null)).toMatchObject({ ok: false });
+    expect(tmux.sendShellCommand).not.toHaveBeenCalled();
+  });
+  it("useG1Credits=true refuses the restore relaunch as attention_required, typing nothing (spec §79)", async () => {
+    const { a, tmux } = mk([READY], true);
+    expect(await a.resume("s", "antigravity_id", ID, "/w", null)).toMatchObject({ ok: false, code: "attention_required", message: expect.stringContaining("useG1Credits") });
+    expect(tmux.sendShellCommand).not.toHaveBeenCalled();
+  });
+  it("false/unknown proceeds", async () => {
+    for (const g1 of [false, "unknown"] as const) expect((await mk([READY], g1).a.resume("s", "antigravity_id", ID, "/w", null)).ok).toBe(true);
+  });
+});
diff --git a/packages/daemon/test/antigravity-runtime-adapter.test.ts b/packages/daemon/test/antigravity-runtime-adapter.test.ts
