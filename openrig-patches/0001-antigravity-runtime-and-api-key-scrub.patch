@@ -0,0 +1,96 @@
+import { describe, expect, it } from "vitest";
+import { parseLsofConversationIds, readAgyConversationId } from "../src/adapters/antigravity-conversation.js";
+import { deriveResumeToken } from "../src/domain/resume-token-capture.js";
+
+const ID = "bbdd6f6c-7c1c-4899-9f6e-843a3d73de22";
+// `lsof -Fn` shape: one "n<path>" line per open file.
+const lsof = (...names: string[]) => names.map((n) => `n${n}`).join("\n");
+const DIR = "/Users/brandon/.gemini/antigravity-cli/conversations";
+
+describe("parseLsofConversationIds", () => {
+  it("returns the conversation uuid from the open .db/-wal/-shm/.lock, ignoring conversation_summaries", () => {
+    const out = lsof(`${DIR}/${ID}.db`, `${DIR}/${ID}.db-wal`, `${DIR}/${ID}.db-shm`, `${DIR}/conversation_summaries.db`, "/dev/null");
+    expect(parseLsofConversationIds(out)).toEqual([ID]);
+  });
+  it("de-duplicates, and reports every distinct conversation held", () => {
+    const other = "11111111-2222-3333-4444-555555555555";
+    expect(parseLsofConversationIds(lsof(`${DIR}/${ID}.db`, `${DIR}/${other}.db`)).sort()).toEqual([ID, other].sort());
+  });
+  it("garbage / empty => no ids", () => {
+    expect(parseLsofConversationIds("")).toEqual([]);
+    expect(parseLsofConversationIds("nnot-a-conversation.db")).toEqual([]);
+  });
+});
+
+describe("readAgyConversationId", () => {
+  const base = (over: Partial<Parameters<typeof readAgyConversationId>[0]> = {}) => ({
+    panePid: async () => 100,
+    children: async (pid: number) => (pid === 100 ? [200] : []),
+    comm: async (pid: number) => (pid === 200 ? "agy" : "zsh"),
+    lsof: async (pid: number) => (pid === 200 ? lsof(`${DIR}/${ID}.db`) : ""),
+    ...over,
+  });
+  it("finds agy in the pane's process tree (shell -> agy) and returns its conversation id", async () => {
+    expect(await readAgyConversationId(base())).toEqual({ ok: true, conversationId: ID });
+  });
+  it("agy as the pane process itself works too", async () => {
+    expect(await readAgyConversationId(base({ comm: async () => "agy", children: async () => [], lsof: async () => lsof(`${DIR}/${ID}.db`) }))).toEqual({ ok: true, conversationId: ID });
+  });
+  it("no agy process => skip reason, never a guess", async () => {
+    expect(await readAgyConversationId(base({ comm: async () => "zsh" }))).toEqual({ ok: false, reason: "no_agy_process" });
+  });
+  it("agy up but no conversation yet (before the first prompt) => not_yet_created", async () => {
+    expect(await readAgyConversationId(base({ lsof: async () => lsof(`${DIR}/conversation_summaries.db`) }))).toEqual({ ok: false, reason: "not_yet_created" });
+  });
+  it("more than one conversation held => ambiguous, no token", async () => {
+    expect(await readAgyConversationId(base({ lsof: async () => lsof(`${DIR}/${ID}.db`, `${DIR}/11111111-2222-3333-4444-555555555555.db`) }))).toEqual({ ok: false, reason: "ambiguous" });
+  });
+  it("probe errors degrade to a skip, never throw", async () => {
+    expect(await readAgyConversationId(base({ lsof: async () => { throw new Error("lsof missing"); } }))).toMatchObject({ ok: false });
+    expect(await readAgyConversationId(base({ panePid: async () => null }))).toEqual({ ok: false, reason: "no_agy_process" });
+  });
+});
+
+describe("deriveResumeToken for antigravity", () => {
+  it("captures the conversation id via the injected reader", async () => {
+    const r = await deriveResumeToken({ runtime: "antigravity", sessionName: "dev-gem@rig" }, { antigravityConversationReader: { read: async () => ({ ok: true, conversationId: ID }) } });
+    expect(r).toEqual({ outcome: "captured", resumeType: "antigravity_id", token: ID });
+  });
+  it("reader skip => honest skipped; absent reader => noop", async () => {
+    expect(await deriveResumeToken({ runtime: "antigravity", sessionName: "s" }, { antigravityConversationReader: { read: async () => ({ ok: false, reason: "not_yet_created" }) } })).toMatchObject({ outcome: "skipped" });
+    expect(await deriveResumeToken({ runtime: "antigravity", sessionName: "s" }, {})).toEqual({ outcome: "noop" });
+  });
+});
+
+import { vi } from "vitest";
+import { ResumeMetadataRefresher } from "../src/domain/resume-metadata-refresher.js";
+
+describe("ResumeMetadataRefresher antigravity branch (snapshot-time capture)", () => {
+  const mk = (read: () => Promise<{ ok: true; conversationId: string } | { ok: false; reason: string }>) => {
+    const sessionRegistry = { updateResumeToken: vi.fn(), markResumeProbeResult: vi.fn() };
+    const r = new ResumeMetadataRefresher({ sessionRegistry: sessionRegistry as never, tmuxAdapter: {} as never, antigravityConversationReader: { read } });
+    return { r, sessionRegistry };
+  };
+  const session = (resumeToken: string | null) => ({ sessionId: "s1", sessionName: "dev-gem@rig", runtime: "antigravity", resumeToken }) as never;
+
+  it("null-fills the token from the live conversation (scrape provenance)", async () => {
+    const { r, sessionRegistry } = mk(async () => ({ ok: true, conversationId: ID }));
+    await r.refresh([session(null)], { fillNullOnly: true });
+    expect(sessionRegistry.updateResumeToken).toHaveBeenCalledWith("s1", "antigravity_id", ID, "scrape");
+  });
+  it("not yet created / ambiguous => nothing written", async () => {
+    const { r, sessionRegistry } = mk(async () => ({ ok: false, reason: "not_yet_created" }));
+    await r.refresh([session(null)], { fillNullOnly: true });
+    expect(sessionRegistry.updateResumeToken).not.toHaveBeenCalled();
+  });
+  it("a present token is never clobbered; an equal live id re-stamps freshness; a different one is left alone", async () => {
+    const same = mk(async () => ({ ok: true, conversationId: ID }));
+    await same.r.refresh([session(ID)], { fillNullOnly: true });
+    expect(same.sessionRegistry.updateResumeToken).not.toHaveBeenCalled();
+    expect(same.sessionRegistry.markResumeProbeResult).toHaveBeenCalledWith("s1", "resumable");
+    const diff = mk(async () => ({ ok: true, conversationId: "11111111-2222-3333-4444-555555555555" }));
+    await diff.r.refresh([session(ID)], { fillNullOnly: true });
+    expect(diff.sessionRegistry.updateResumeToken).not.toHaveBeenCalled();
+    expect(diff.sessionRegistry.markResumeProbeResult).not.toHaveBeenCalled();
+  });
+});
