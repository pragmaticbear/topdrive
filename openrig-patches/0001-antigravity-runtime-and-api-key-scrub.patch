diff --git a/packages/daemon/src/adapters/antigravity-conversation.ts b/packages/daemon/src/adapters/antigravity-conversation.ts
new file mode 100644
index 0000000..fe907cc
--- /dev/null
+++ b/packages/daemon/src/adapters/antigravity-conversation.ts
@@ -0,0 +1,48 @@
+// topdrive: the agy conversation id of a live seat, read from the OS: the `agy` process holds its own
+// conversation DB (<uuid>.db/-wal/-shm/.lock) open. Exact per seat even with several agy seats, unlike a
+// before/after directory diff. Read-only (ps/lsof); never guesses: zero or several conversations => a skip reason.
+
+export type AgyConversationRead =
+  | { ok: true; conversationId: string }
+  | { ok: false; reason: "no_agy_process" | "not_yet_created" | "ambiguous" | "probe_failed" };
+
+const CONVERSATION_FILE = /\/conversations\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.(?:db|db-wal|db-shm|lock)$/;
+
+/** Distinct conversation uuids named in `lsof -Fn` output (conversation_summaries.db never matches). */
+export function parseLsofConversationIds(lsofFn: string): string[] {
+  const ids = new Set<string>();
+  for (const line of lsofFn.split("\n")) {
+    if (!line.startsWith("n")) continue;
+    const m = CONVERSATION_FILE.exec(line.slice(1));
+    if (m) ids.add(m[1]!);
+  }
+  return [...ids];
+}
+
+export interface AgyConversationProbe {
+  panePid: () => Promise<number | null>;
+  children: (pid: number) => Promise<number[]>;
+  comm: (pid: number) => Promise<string>;
+  lsof: (pid: number) => Promise<string>;
+}
+
+export async function readAgyConversationId(p: AgyConversationProbe): Promise<AgyConversationRead> {
+  try {
+    const root = await p.panePid();
+    if (root === null) return { ok: false, reason: "no_agy_process" };
+    // The pane runs a shell with agy as a child (managed seats) or agy directly; look at the pane process and descendants (depth <= 3).
+    let frontier = [root];
+    let agyPid: number | null = null;
+    for (let depth = 0; depth < 4 && agyPid === null && frontier.length; depth++) {
+      for (const pid of frontier) if ((await p.comm(pid)).split("/").pop() === "agy") { agyPid = pid; break; }
+      if (agyPid === null) frontier = (await Promise.all(frontier.map((pid) => p.children(pid)))).flat();
+    }
+    if (agyPid === null) return { ok: false, reason: "no_agy_process" };
+    const ids = parseLsofConversationIds(await p.lsof(agyPid));
+    if (ids.length === 0) return { ok: false, reason: "not_yet_created" };
+    if (ids.length > 1) return { ok: false, reason: "ambiguous" };
+    return { ok: true, conversationId: ids[0]! };
+  } catch {
+    return { ok: false, reason: "probe_failed" };
+  }
+}
diff --git a/packages/daemon/src/adapters/antigravity-resume.ts b/packages/daemon/src/adapters/antigravity-resume.ts
new file mode 100644
index 0000000..8670dd2
--- /dev/null
+++ b/packages/daemon/src/adapters/antigravity-resume.ts
@@ -0,0 +1,64 @@
+// topdrive: Antigravity seat resume (mirrors codex-resume.ts). Relaunches `agy --conversation <id>` in the seat's
+// pane through the SAME command builder as a fresh launch (billing scrub stays), then waits for the TUI's ready
+// footer. A trust prompt is attention-required (operator action), never a silent failure.
+
+import { setTimeout as sleep } from "node:timers/promises";
+import type { TmuxAdapter } from "./tmux.js";
+import type { ResumeResult } from "./claude-resume.js";
+import { validateResumeToken } from "../domain/resume-token-validation.js";
+import { AGY_READY_MARKER, AGY_TRUST_MARKER, buildAgyLaunchCommand } from "./antigravity-runtime-adapter.js";
+
+export { type ResumeResult };
+
+interface AntigravityResumeOptions {
+  pollMs?: number;
+  maxWaitMs?: number;
+  sleep?: (ms: number) => Promise<void>;
+  /** `useG1Credits` from agy; true => refuse (paid overage). Failures count as unknown. */
+  readUseG1Credits?: () => Promise<boolean | "unknown">;
+}
+
+export class AntigravityResumeAdapter {
+  constructor(private tmux: TmuxAdapter, private options: AntigravityResumeOptions = {}) {}
+
+  canResume(resumeType: string | null, resumeToken: string | null): boolean {
+    return resumeType === "antigravity_id" && !!resumeToken;
+  }
+
+  async resume(
+    tmuxSessionName: string,
+    _resumeType: string | null,
+    resumeToken: string | null,
+    _cwd: string,
+    model?: string | null,
+    resolvedPosture?: "floor" | "full_bypass",
+    effort?: string | null,
+  ): Promise<ResumeResult> {
+    const v = validateResumeToken("antigravity", resumeToken);
+    if (!v.ok) return { ok: false, code: "invalid_resume_token", message: `antigravity resume: ${v.error}` };
+
+    let g1: boolean | "unknown" = "unknown";
+    try { g1 = (await this.options.readUseG1Credits?.()) ?? "unknown"; } catch { /* unknown */ }
+    if (g1 === true) {
+      return { ok: false, code: "attention_required", message: "agy has useG1Credits=true, so an exhausted plan would spend purchased credits (allow_paid_overage=false). Turn it off in agy (/config), then retry the restore." };
+    }
+
+    const cmd = buildAgyLaunchCommand({ resumeToken: v.token, model, effort, fullBypass: resolvedPosture === "full_bypass" });
+    const sent = await this.tmux.sendShellCommand(tmuxSessionName, cmd);
+    if (!sent.ok) return { ok: false, code: "launch_failed", message: `Failed to send resume command: ${sent.message}` };
+
+    const pollMs = this.options.pollMs ?? 500;
+    const maxWaitMs = this.options.maxWaitMs ?? 30_000;
+    const wait = this.options.sleep ?? ((ms: number) => sleep(ms));
+    let last = "";
+    for (let waited = 0; waited <= maxWaitMs; waited += pollMs) {
+      last = (await this.tmux.capturePaneContent(tmuxSessionName, 40)) ?? "";
+      if (last.includes(AGY_TRUST_MARKER)) {
+        return { ok: false, code: "attention_required", message: "agy is waiting on the folder trust prompt; trust this folder once, then retry the restore", evidence: last.split("\n").slice(-8).join("\n") };
+      }
+      if (last.includes(AGY_READY_MARKER)) return { ok: true };
+      await wait(pollMs);
+    }
+    return { ok: false, code: "resume_not_ready", message: "agy did not become ready after `--conversation` resume", evidence: last.split("\n").slice(-8).join("\n") } as ResumeResult;
+  }
+}
diff --git a/packages/daemon/src/adapters/antigravity-runtime-adapter.ts b/packages/daemon/src/adapters/antigravity-runtime-adapter.ts
new file mode 100644
index 0000000..b2e771f
--- /dev/null
+++ b/packages/daemon/src/adapters/antigravity-runtime-adapter.ts
@@ -0,0 +1,215 @@
+// topdrive — the Antigravity (`agy`) runtime adapter (tmux TUI seat, Codex/Claude shape).
+//
+// Facts probed against agy 1.2.14 (see OPENRIG_EXTENSION_MAP.md):
+//  - agy draws on the alternate screen; pane_current_command misreports ("bash"), so screen markers are authoritative.
+//  - The ready screen shows the footer "? for shortcuts"; a first launch in a new folder shows a
+//    trust gate ("Do you trust the contents of this project?") — surfaced as attention-required.
+//  - The conversation DB (<conversationsDir>/<uuid>.db) is created only after the FIRST prompt, so a
+//    fresh launch has no resume token yet; captureConversationId() derives it later from a
+//    before/after directory diff and refuses to guess when ambiguous.
+//  - Resume = `agy --conversation <uuid>`. Fork is not supported.
+//  - Billing guard (subscription_only): the launch command unsets API-credential env so the seat can
+//    only use the interactive account login. Bypass flag only for an explicit full_bypass posture.
+
+import nodePath from "node:path";
+import os from "node:os";
+import type { TmuxAdapter } from "./tmux.js";
+import type {
+  RuntimeAdapter, NodeBinding, ResolvedStartupFile, InstalledResource, ProjectionResult,
+  StartupDeliveryResult, ReadinessResult, HarnessLaunchResult, ForkSource,
+} from "../domain/runtime-adapter.js";
+import { resolveConcreteHint } from "../domain/runtime-adapter.js";
+import type { ProjectionPlan } from "../domain/projection-planner.js";
+import { validateResumeToken } from "../domain/resume-token-validation.js";
+import { mergeManagedBlock } from "../domain/managed-blocks.js";
+import { shellQuote } from "./shell-quote.js";
+import { readAgyConversationId, type AgyConversationProbe, type AgyConversationRead } from "./antigravity-conversation.js";
+
+export const AGY_CONVERSATIONS_DIR_DEFAULT = nodePath.join(os.homedir(), ".gemini", "antigravity-cli", "conversations");
+/** API-credential env that would switch agy off the subscription login. */
+export const AGY_STRIPPED_ENV = ["GEMINI_API_KEY", "GOOGLE_API_KEY"] as const;
+
+const SHELL_COMMANDS = new Set(["bash", "fish", "nu", "sh", "tmux", "zsh"]);
+export const AGY_READY_MARKER = "? for shortcuts";
+export const AGY_TRUST_MARKER = "Do you trust the contents of this project?";
+const READY_MARKER = AGY_READY_MARKER;
+const TRUST_MARKER = AGY_TRUST_MARKER;
+const CONVERSATION_RE = /^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.db$/;
+
+/** The one place the agy launch command is assembled (billing scrub, resume, model, effort, posture). */
+export function buildAgyLaunchCommand(o: { resumeToken?: string; model?: string | null; effort?: string | null; fullBypass?: boolean }): string {
+  return [
+    `env ${AGY_STRIPPED_ENV.map((n) => `-u ${n}`).join(" ")} agy`,
+    o.resumeToken ? `--conversation ${shellQuote(o.resumeToken)}` : "",
+    o.model?.trim() ? `--model ${shellQuote(o.model.trim())}` : "",
+    o.effort?.trim() ? `--effort ${shellQuote(o.effort.trim())}` : "",
+    o.fullBypass ? "--dangerously-skip-permissions" : "",
+  ].filter(Boolean).join(" ");
+}
+
+export interface AntigravityFsOps {
+  readFile(path: string): string;
+  writeFile(path: string, content: string): void;
+  exists(path: string): boolean;
+  mkdirp(path: string): void;
+  listFiles?(dirPath: string): string[];
+}
+
+export interface AntigravityAdapterDeps {
+  tmux: TmuxAdapter;
+  fsOps: AntigravityFsOps;
+  conversationsDir?: string;
+  /** Builds the OS probe (ps/lsof) for one seat; absent => conversation capture is a no-op. */
+  conversationProbe?: (sessionName: string) => AgyConversationProbe;
+  /** `useG1Credits` from `agy /config`. true => purchased credits could be spent past plan quota => launch refused. */
+  readUseG1Credits?: () => Promise<boolean | "unknown">;
+  sleep?: (ms: number) => Promise<void>;
+}
+
+export class AntigravityRuntimeAdapter implements RuntimeAdapter {
+  readonly runtime = "antigravity";
+  private tmux: TmuxAdapter;
+  private fs: AntigravityFsOps;
+  private conversationsDir: string;
+  private sleep: (ms: number) => Promise<void>;
+  private conversationProbe: AntigravityAdapterDeps["conversationProbe"];
+  private readUseG1Credits: AntigravityAdapterDeps["readUseG1Credits"];
+
+  constructor(deps: AntigravityAdapterDeps) {
+    this.readUseG1Credits = deps.readUseG1Credits;
+    this.conversationProbe = deps.conversationProbe;
+    this.tmux = deps.tmux;
+    this.fs = deps.fsOps;
+    this.conversationsDir = deps.conversationsDir ?? AGY_CONVERSATIONS_DIR_DEFAULT;
+    this.sleep = deps.sleep ?? ((ms) => new Promise((r) => setTimeout(r, ms)));
+  }
+
+  /** The seat's live conversation id (resume-token source). Structural shape shared with the other runtimes' readers. */
+  async read(sessionName: string): Promise<AgyConversationRead> {
+    if (!this.conversationProbe) return { ok: false, reason: "probe_failed" };
+    return readAgyConversationId(this.conversationProbe(sessionName));
+  }
+
+  /** Conversation ids currently on disk — snapshot before launch to diff after the first prompt. */
+  snapshotConversationFiles(): Set<string> {
+    return new Set(this.fs.listFiles?.(this.conversationsDir) ?? []);
+  }
+
+  /** The single conversation uuid that appeared since `before`; null when none or ambiguous. */
+  captureConversationId(before: Set<string>): string | null {
+    const fresh = (this.fs.listFiles?.(this.conversationsDir) ?? [])
+      .filter((f) => !before.has(f))
+      .map((f) => CONVERSATION_RE.exec(f)?.[1])
+      .filter((id): id is string => !!id);
+    return fresh.length === 1 ? fresh[0]! : null;
+  }
+
+  async listInstalled(_binding: NodeBinding): Promise<InstalledResource[]> {
+    return [];
+  }
+
+  // v1: guidance only (AGENTS.md managed block). Skills are skipped, not failed.
+  async project(plan: ProjectionPlan, binding: NodeBinding): Promise<ProjectionResult> {
+    const projected: string[] = [];
+    const skipped: string[] = [];
+    const failed: Array<{ effectiveId: string; error: string }> = [];
+    for (const entry of plan.entries) {
+      if (entry.classification === "no_op" || entry.category !== "guidance") {
+        skipped.push(entry.effectiveId);
+        continue;
+      }
+      try {
+        if (this.mergeGuidance(nodePath.join(binding.cwd, "AGENTS.md"), entry.effectiveId, this.fs.readFile(entry.absolutePath))) {
+          projected.push(entry.effectiveId);
+        } else {
+          skipped.push(entry.effectiveId);
+        }
+      } catch (err) {
+        failed.push({ effectiveId: entry.effectiveId, error: (err as Error).message });
+      }
+    }
+    return { projected, skipped, failed };
+  }
+
+  async deliverStartup(files: ResolvedStartupFile[], binding: NodeBinding): Promise<StartupDeliveryResult> {
+    let delivered = 0;
+    const failed: Array<{ path: string; error: string }> = [];
+    for (const file of files) {
+      try {
+        const content = this.fs.readFile(file.absolutePath);
+        const hint = file.deliveryHint === "auto" ? resolveConcreteHint(file.path, content) : file.deliveryHint;
+        if (hint === "guidance_merge") {
+          if (!this.mergeGuidance(nodePath.join(binding.cwd, "AGENTS.md"), file.path, content)) continue;
+        } else if (hint === "send_text" && binding.tmuxSession) {
+          const t = await this.tmux.sendText(binding.tmuxSession, content);
+          if (!t.ok) throw new Error(t.message);
+          await this.sleep(200);
+          const s = await this.tmux.sendKeys(binding.tmuxSession, ["C-m"]);
+          if (!s.ok) throw new Error(s.message);
+        } else {
+          continue; // skill_install: unsupported in v1, not counted as delivered
+        }
+        delivered++;
+      } catch (err) {
+        if (file.required) failed.push({ path: file.path, error: (err as Error).message });
+      }
+    }
+    return { delivered, failed };
+  }
+
+  async launchHarness(
+    binding: NodeBinding,
+    opts: { name: string; resumeToken?: string; forkSource?: ForkSource },
+  ): Promise<HarnessLaunchResult> {
+    if (!binding.tmuxSession) return { ok: false, error: "No tmux session bound — cannot launch the Antigravity harness" };
+    if (opts.resumeToken && opts.forkSource) return { ok: false, error: "resumeToken and forkSource are mutually exclusive — pick one" };
+    if (opts.forkSource) return { ok: false, error: "antigravity fork is not supported in v1" };
+
+    // Paid-overage guard: a probe failure never blocks (doctor warns); only an explicit `true` does.
+    let g1: boolean | "unknown" = "unknown";
+    try { g1 = (await this.readUseG1Credits?.()) ?? "unknown"; } catch { /* unknown */ }
+    if (g1 === true) {
+      return { ok: false, error: "agy has useG1Credits=true, so an exhausted plan would spend purchased credits (allow_paid_overage=false). Turn it off in agy (/config) and relaunch.", recovery: "attention_required" };
+    }
+
+    let resumeToken: string | undefined;
+    if (opts.resumeToken) {
+      const v = validateResumeToken("antigravity", opts.resumeToken);
+      if (!v.ok) return { ok: false, error: `antigravity resume: ${v.error}` };
+      resumeToken = v.token;
+    }
+
+    const cmd = buildAgyLaunchCommand({ ...(resumeToken ? { resumeToken } : {}), model: binding.model, effort: binding.effort, fullBypass: binding.launchPosture === "full_bypass" });
+
+    const sent = await this.tmux.sendShellCommand(binding.tmuxSession, cmd);
+    if (!sent.ok) return { ok: false, error: `Failed to send launch command: ${sent.message}` };
+
+    // A fresh seat has no conversation id until its first prompt (see header); never fabricate one.
+    return resumeToken ? { ok: true, resumeToken, resumeType: "antigravity_id" } : { ok: true };
+  }
+
+  async checkReady(binding: NodeBinding): Promise<ReadinessResult> {
+    if (!binding.tmuxSession) return { ready: false, reason: "No tmux session bound" };
+    if (!(await this.tmux.hasSession(binding.tmuxSession))) return { ready: false, reason: "tmux session not responsive" };
+    // agy draws on the terminal's alternate screen, so a marker on the CURRENT screen proves the TUI is up; stale
+    // scrollback cannot satisfy it. pane_current_command is NOT trustworthy here (probed: "bash" while agy runs).
+    const pane = (await this.tmux.capturePaneContent(binding.tmuxSession, 40)) ?? "";
+    if (pane.includes(TRUST_MARKER)) {
+      return { ready: false, reason: "agy is waiting on the folder trust prompt; run `agy` once in this folder and trust it (stored in ~/.gemini/antigravity-cli/settings.json)", code: "trust_gate" };
+    }
+    if (pane.includes(READY_MARKER)) return { ready: true };
+    const paneCommand = (await this.tmux.getPaneCommand(binding.tmuxSession)) ?? "";
+    if (SHELL_COMMANDS.has(paneCommand)) {
+      return { ready: false, reason: "agy is not running; the pane is back at a shell", code: "runner_exited" };
+    }
+    return { ready: false, reason: "agy has not reported ready yet", code: "awaiting_runtime" };
+  }
+
+  // Per-seat `rig-role` content collides across pod-mates in a shared cwd file; it is delivered via
+  // send_text instead (same rule as the Pi/Codex adapters, ADR-0006).
+  private mergeGuidance(targetPath: string, blockId: string, content: string): boolean {
+    if (blockId === "rig-role") return false;
+    mergeManagedBlock(this.fs, targetPath, blockId, content);
+    return true;
+  }
+}
